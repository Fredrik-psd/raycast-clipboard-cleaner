{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "clipboard-cleaner",
  "title": "Clipboard Cleaner",
  "description": "Clean copied text — strip empty lines, add spacing around a character, or find and replace.",
  "icon": "icon.png",
  "author": "Fredrik-psd",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "clipboard-cleaner",
      "title": "Clipboard Cleaner",
      "description": "Choose a cleaner for the copied text",
      "mode": "view",
      "keywords": [
        "clipboard",
        "clean",
        "text",
        "line"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "1.104.12"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.1.1",
    "@types/node": "25.6.0",
    "eslint": "10.2.1",
    "prettier": "3.8.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  }
}
